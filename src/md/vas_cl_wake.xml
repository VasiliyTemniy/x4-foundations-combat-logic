<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VAS_CombatLogic_Wake" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    CL scan/pursuit heartbeat.
    Signals sectors with the 'vas_cl_wake' param; consumer aiscript injections and the CL pursuit
    handler key off that signal. Consumers register their desired heartbeat interval in
    global.$vas_cl_wake_intervals.{'<consumer id>'}; the densest (minimum) registered interval sizes
    the buckets. Per-consumer scan cadence is throttled consumer-side, so a denser heartbeat only
    costs extra interrupt wakeups, never extra scans.
    Sectors are split into buckets so the mod does not signal every sector on the same second.
    -->
  <cues>
    <cue name="InitWakeBuckets" instantiate="true">
      <conditions>
        <event_universe_generated/>
      </conditions>
      <actions>
        <run_actions ref="BuildWakeBuckets"/>
      </actions>
    </cue>

    <cue name="WakeBucketsRefresh" checkinterval="30" instantiate="true">
      <actions>
        <!-- Rebuild periodically so consumer interval changes and sector-list changes heal without save-state fuss. -->
        <run_actions ref="BuildWakeBuckets"/>
      </actions>
    </cue>

    <library name="BuildWakeBuckets" purpose="run_actions">
      <actions>
        <!-- Minimum registered consumer interval wins; 30s fallback when no consumer has registered yet. -->
        <set_value name="$vas_cl_wake_interval" exact="30s"/>
        <do_if value="@global.$vas_cl_wake_intervals.keys.count">
          <do_all exact="global.$vas_cl_wake_intervals.keys.count" counter="$vas_cl_wake_consumer_index">
            <set_value name="$vas_cl_wake_consumer_interval" exact="global.$vas_cl_wake_intervals.{global.$vas_cl_wake_intervals.keys.list.{$vas_cl_wake_consumer_index}}"/>
            <do_if value="$vas_cl_wake_consumer_interval lt $vas_cl_wake_interval">
              <set_value name="$vas_cl_wake_interval" exact="$vas_cl_wake_consumer_interval"/>
            </do_if>
          </do_all>
        </do_if>

        <!-- One bucket is signalled per second; bucket count therefore matches the heartbeat interval in seconds. -->
        <set_value name="$vas_cl_wake_bucket_count" exact="[($vas_cl_wake_interval / 1s)i, 1].max"/>
        <set_value name="global.$vas_cl_wake_bucket_count" exact="$vas_cl_wake_bucket_count"/>
        <set_value name="global.$vas_cl_wake_buckets" exact="table[]"/>
        <do_all exact="$vas_cl_wake_bucket_count" counter="$vas_cl_wake_bucket_index">
          <set_value name="global.$vas_cl_wake_buckets.{$vas_cl_wake_bucket_index}" exact="[]"/>
        </do_all>

        <find_sector name="$vas_cl_wake_sectors" multiple="true"/>
        <!-- Round-robin distribution keeps each 1-second wake tick roughly the same size. -->
        <set_value name="$vas_cl_wake_bucket_index" exact="1"/>
        <do_for_each name="$vas_cl_wake_sector" in="$vas_cl_wake_sectors">
          <append_to_list name="global.$vas_cl_wake_buckets.{$vas_cl_wake_bucket_index}" exact="$vas_cl_wake_sector"/>
          <set_value name="$vas_cl_wake_bucket_index" exact="$vas_cl_wake_bucket_index + 1"/>
          <do_if value="$vas_cl_wake_bucket_index gt $vas_cl_wake_bucket_count">
            <set_value name="$vas_cl_wake_bucket_index" exact="1"/>
          </do_if>
        </do_for_each>

        <do_if value="not @global.$vas_cl_wake_bucket_index or global.$vas_cl_wake_bucket_index gt $vas_cl_wake_bucket_count">
          <set_value name="global.$vas_cl_wake_bucket_index" exact="1"/>
        </do_if>
      </actions>
    </library>

    <cue name="WakeTick" checkinterval="1" instantiate="true">
      <actions>
        <!-- Init wake tickets -->
        <do_if value="not @global.$vas_cl_wake_ticket">
          <set_value name="global.$vas_cl_wake_ticket" exact="table[]"/>
        </do_if>

        <!-- Signal only the current bucket; consumer scan injections still have their own per-ship interval gate. -->
        <do_if value="@global.$vas_cl_wake_buckets and @global.$vas_cl_wake_bucket_count">
          <do_if value="not @global.$vas_cl_wake_bucket_index or global.$vas_cl_wake_bucket_index gt global.$vas_cl_wake_bucket_count">
            <set_value name="global.$vas_cl_wake_bucket_index" exact="1"/>
          </do_if>

          <set_value name="$vas_cl_wake_bucket_index" exact="global.$vas_cl_wake_bucket_index"/>
          <set_value name="$vas_cl_wake_sectors" exact="global.$vas_cl_wake_buckets.{$vas_cl_wake_bucket_index}"/>
          <do_if value="@$vas_cl_wake_sectors.count">
            <do_for_each name="$vas_cl_wake_sector" in="$vas_cl_wake_sectors">
              <!-- Reset this sector's per-wake ticket so consumer scan injections can stagger same-tick ships;
                   safe because a sector lives in exactly one bucket and is signalled at most once per interval. -->
              <set_value name="global.$vas_cl_wake_ticket.{$vas_cl_wake_sector}" exact="0"/>
              <signal_objects object="$vas_cl_wake_sector" param="'vas_cl_wake'"/>
            </do_for_each>
          </do_if>

          <set_value name="global.$vas_cl_wake_bucket_index" exact="global.$vas_cl_wake_bucket_index + 1"/>
          <do_if value="global.$vas_cl_wake_bucket_index gt global.$vas_cl_wake_bucket_count">
            <set_value name="global.$vas_cl_wake_bucket_index" exact="1"/>
          </do_if>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
