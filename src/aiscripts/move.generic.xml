<?xml version="1.0" encoding="utf-8" ?>
<diff>
  <!-- Internal flag for CL-owned approach movement. -->
  <!-- FRAGILITY - NONE: adds one optional internal param to MoveGeneric.
       INJECTION FAIL IMPACT: if this injection fails, CL ship-target approach movement cannot be marked,
                              which means the sector guard below cannot distinguish CL movement
                              from vanilla movement. -->
  <add sel="/aiscript/order/params">
    <param name="vas_cl_issued_by_cl" default="false" type="internal"/>
  </add>

  <!-- CL ship-target approach movement may use pursuetargets=true so MoveGeneric follows a moving target
       inside the same sector. -->
  <!-- FRAGILITY - LOW: label 'check' is a stable vanilla MoveGeneric control-flow anchor.
       INJECTION FAIL IMPACT: if this injection fails, CL MoveGeneric approach legs can follow moving
                              ship targets through gates, which means patrol ships may leave the patrol
                              sector before the Attack order guard can stop them. -->
  <add sel="//label[@name=&quot;check&quot;]" pos="after">
    <do_if value="@$vas_cl_issued_by_cl">
      <do_if value="@$destination.exists">
        <do_if value="($destination.isclass.ship or $destination.isclass.station) and this.ship.sector and $destination.sector and this.ship.sector != $destination.sector">
          <set_value name="$returnvalue" exact="true"/>
          <resume label="cleanup"/>
        </do_if>
      </do_if>
    </do_if>
  </add>
</diff>
